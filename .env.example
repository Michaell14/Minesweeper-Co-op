# Copy to .env.local for local overrides. Both values are optional.

# Backend the client connects to. Unset defaults to http://localhost:3001 in
# development and the deployed Heroku app in production. Inlined at build time,
# so a rebuild is required after changing it.
NEXT_PUBLIC_SOCKET_URL=

NODE_ENV=development

# --- Accounts (all optional; with none set, sign-in is simply unavailable) ---

# OAuth apps. A provider's sign-in button appears only when its pair is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth's own session: the deployed origin (http://localhost:3000 in dev)
# and the secret its session cookie is encrypted with.
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Signs the bridge token that carries a sign-in across to the game server.
# Must be the SAME value as AUTH_BRIDGE_SECRET in server/.env — see
# app/api/socket-token/route.ts and server/utils/authToken.js.
AUTH_BRIDGE_SECRET=
