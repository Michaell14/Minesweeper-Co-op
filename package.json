{
  "name": "minesweeper-test",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "ensure-redis": "node scripts/ensure-redis.js",
    "dev:all": "npm run ensure-redis && npx concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run start-server\" \"npm run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm --prefix server test",
    "test:ui": "node scripts/ui-smoke/run.js",
    "verify:deploy": "node scripts/verify-deploy/run.js",
    "start-server": "cd server && node server.js",
    "heroku-postbuild": "node scripts/write-version.js && cd server && npm install",
    "test:client": "vitest run"
  },
  "dependencies": {
    "@vercel/analytics": "^1.4.1",
    "canvas-confetti": "^1.9.3",
    "next": "14.2.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^10.0.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
