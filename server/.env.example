# Copy to server/.env and fill in. All values have working defaults for local dev.

# Redis connection. Unset means localhost:6379 with no auth, which is what
# `npm run dev:all` starts for you.
HOST=
REDIS_PORT=
DB_PASS=

# Port the socket server listens on. Heroku sets this for you.
PORT=3001

# Comma-separated browser origins allowed to connect. Unset falls back to
# localhost:3000 plus the deployed frontends — see server/config.js.
ALLOWED_ORIGINS=

# Postgres for durable account data (users; later settings/themes/stats).
# Unset means no database: account features off, the game fully unaffected.
# Heroku sets this when the Postgres addon is provisioned.
DATABASE_URL=

# Verifies the auth bridge token minted by the frontend. Must be the SAME
# value as AUTH_BRIDGE_SECRET in the frontend's env. Unset means every player
# is anonymous. Deliberately no default — a guessable secret would let anyone
# mint identities.
AUTH_BRIDGE_SECRET=
