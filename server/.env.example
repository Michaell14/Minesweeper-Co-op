# Copy to server/.env and fill in. All values have working defaults for local dev.

# Redis connection. Unset means localhost:6379 with no auth, which is what
# `npm run dev:all` starts for you.
HOST=
REDIS_PORT=
DB_PASS=

# Port the socket server listens on. Heroku sets this for you.
PORT=3001

# Comma-separated browser origins allowed to connect. Unset falls back to
# localhost:3000 plus the deployed frontends — see server/config.js.
ALLOWED_ORIGINS=
